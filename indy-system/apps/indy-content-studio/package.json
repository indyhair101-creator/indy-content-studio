{
  "name": "indy-content-studio",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate-review.mjs && node scripts/migrate-mcp.mjs --if-enabled && next build",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "mcp:migrate": "node --env-file-if-exists=.env.local scripts/migrate-mcp.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.2",
    "@vercel/blob": "2.4.0",
    "google-auth-library": "10.3.0",
    "next": "15.5.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.3",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "fake-indexeddb": "6.2.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
